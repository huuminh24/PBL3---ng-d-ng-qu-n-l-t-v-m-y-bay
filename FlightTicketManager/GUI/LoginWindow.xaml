<Window x:Class="FlightTicketManager.GUI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý Đặt vé Máy bay - Đăng nhập" Height="400" Width="450" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Border Padding="30" Background="White">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ĐĂNG NHẬP HỆ THỐNG" FontSize="26" FontWeight="Bold" Foreground="#005A9E" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Tên đăng nhập:" FontSize="15" Foreground="#333" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="txtUsername" Height="40" FontSize="16" Padding="10,5" Margin="0,0,0,20" 
                     BorderBrush="#CCC" BorderThickness="1" Background="#F9F9F9"/>

            <TextBlock Text="Mật khẩu:" FontSize="15" Foreground="#333" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <PasswordBox x:Name="txtPassword" Height="40" FontSize="16" Padding="10,5" Margin="0,0,0,30" 
                         BorderBrush="#CCC" BorderThickness="1" Background="#F9F9F9"/>

            <Button x:Name="btnLogin" Content="ĐĂNG NHẬP" Height="45" FontSize="16" FontWeight="Bold" 
                    Background="#0078D7" Foreground="White" BorderThickness="0" Cursor="Hand" Click="btnLogin_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Border>
</Window>