<Window x:Class="FlightTicketManager.GUI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý Đặt vé Máy bay - Đăng nhập" Height="500" Width="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EDF2F7">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBlue"     Color="#0194F3"/>
        <SolidColorBrush x:Key="DarkBlue"        Color="#0174C2"/>
        <SolidColorBrush x:Key="DeepBlue"        Color="#0A3D6B"/>
        <SolidColorBrush x:Key="LabelColor"      Color="#4A5568"/>
        <SolidColorBrush x:Key="PlaceholderGray" Color="#A0AEC0"/>
        <SolidColorBrush x:Key="BorderNormal"    Color="#CBD5E0"/>
        <SolidColorBrush x:Key="White"           Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextDark"        Color="#1A202C"/>

        <!-- Style cho Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource LabelColor}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!-- Style cho Border bao TextBox / PasswordBox -->
        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="{StaticResource White}"/>
        </Style>

        <!-- Style cho TextBox -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
        </Style>

        <!-- Style cho PasswordBox -->
        <Style x:Key="InputPass" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
        </Style>

        <!-- Style cho nút chính -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource DarkBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- CARD CHỨA TOÀN BỘ -->
    <Border CornerRadius="20" Margin="30" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Color="#718096" Opacity="0.15" Direction="270" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Bên trái: 2.5/4 -->
                <ColumnDefinition Width="2.5*"/>
                <!-- Bên phải: 1.5/4 -->
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== CỘT TRÁI: BANNER XANH ==================== -->
            <Border Grid.Column="0" CornerRadius="20,0,0,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0194F3" Offset="0"/>
                        <GradientStop Color="#0A3D6B" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,0">

                    <!-- Icon vòng tròn máy bay -->
                    <Border Background="#FFFFFF20" CornerRadius="60" Width="90" Height="90"
                            HorizontalAlignment="Center" Margin="0,0,0,24">
                        <TextBlock Text="&#x2708;" FontSize="42" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Tên thương hiệu -->
                    <TextBlock Text="HmHtravel" FontSize="28" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Hệ thống quản lý đặt vé máy bay" FontSize="13"
                               Foreground="#B3DAFF" HorizontalAlignment="Center"
                               Margin="0,8,0,0" TextAlignment="Center"/>

                    <!-- Đường kẻ phân cách -->
                    <Rectangle Fill="#FFFFFF30" Height="1" Width="180" Margin="0,28,0,28"/>

                    <!-- 3 dòng mô tả tính năng -->
                    <StackPanel Margin="0,0,0,14"/>
                    <StackPanel Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel/>

                </StackPanel>
            </Border>

            <!-- ==================== CỘT PHẢI: FORM ĐĂNG NHẬP ==================== -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="35,0,35,0">

                <!-- Tiêu đề -->
                <TextBlock Text="Đăng nhập" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextDark}" HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Chào mừng bạn trở lại" FontSize="13"
                           Foreground="{StaticResource PlaceholderGray}"
                           HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <!-- Tên đăng nhập -->
                <TextBlock Text="Tên đăng nhập" Style="{StaticResource FieldLabel}"/>
                <Border Style="{StaticResource InputBorder}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderNormal}"
                                BorderThickness="0,0,1,0">
                            <TextBlock Text="@" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource PlaceholderGray}"/>
                        </Border>
                        <TextBox Grid.Column="1" x:Name="txtUsername"
                                 Style="{StaticResource InputBox}"/>
                    </Grid>
                </Border>

                <!-- Mật khẩu -->
                <TextBlock Text="Mật khẩu" Style="{StaticResource FieldLabel}"/>
                <Border Style="{StaticResource InputBorder}" Margin="0,0,0,28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderNormal}"
                                BorderThickness="0,0,1,0">
                            <TextBlock Text="&#128274;" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource PlaceholderGray}"/>
                        </Border>
                        <PasswordBox Grid.Column="1" x:Name="txtPassword"
                                     Style="{StaticResource InputPass}"/>
                    </Grid>
                </Border>

                <!-- Nút đăng nhập -->
                <Button x:Name="btnLogin"
                        Content="Đăng nhập"
                        Style="{StaticResource PrimaryButton}"
                        Click="btnLogin_Click"
                        Margin="0,0,0,16"/>

                <!-- Đăng ký tài khoản -->
                <Border BorderBrush="{StaticResource BorderNormal}" BorderThickness="1"
                        CornerRadius="10" Height="48" Background="Transparent"
                        Cursor="Hand" MouseLeftButtonDown="lblRegister_Click">
                    <TextBlock Text="Tạo tài khoản mới"
                               Foreground="{StaticResource PrimaryBlue}"
                               FontWeight="SemiBold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

            </StackPanel>
        </Grid>
    </Border>
</Window>