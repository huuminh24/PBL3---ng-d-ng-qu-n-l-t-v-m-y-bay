<Window x:Class="FlightTicketManager.GUI.FrmBookingInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin đặt vé"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7FA">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Bên trái: nhập thông tin -->
        <Border Grid.Column="0"
        Background="White"
        CornerRadius="12"
        Padding="20"
        BorderBrush="#D9E2EC"
        BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Thông tin hành khách"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#102A43"
                       Margin="0,0,0,20"/>

                    <TextBlock Text="Họ tên hành khách" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtPassengerName" Height="36" Margin="0,0,0,14"/>

                    <TextBlock Text="Loại hành khách" Margin="0,0,0,6"/>
                    <ComboBox x:Name="cboPassengerType" Height="36" Margin="0,0,0,14" SelectedIndex="0">
                        <ComboBoxItem Content="Adult"/>
                        <ComboBoxItem Content="Child"/>
                        <ComboBoxItem Content="Infant"/>
                    </ComboBox>

                    <TextBlock Text="Loại giấy tờ" Margin="0,0,0,6"/>
                    <ComboBox x:Name="cboDocumentType" Height="36" Margin="0,0,0,14" SelectedIndex="0">
                        <ComboBoxItem Content="CCCD"/>
                        <ComboBoxItem Content="Passport"/>
                    </ComboBox>

                    <TextBlock Text="Số giấy tờ" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtDocumentNumber" Height="36" Margin="0,0,0,14"/>

                    <TextBlock Text="Tên người liên hệ" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtContactName" Height="36" Margin="0,0,0,14"/>

                    <TextBlock Text="Email liên hệ" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtEmail" Height="36" Margin="0,0,0,14"/>

                    <TextBlock Text="Số điện thoại liên hệ" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtPhone" Height="36" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnClose"
                        Content="Đóng"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="#D64545"
                        Foreground="White"
                        BorderThickness="0"
                        Click="btnClose_Click"/>

                        <Button x:Name="btnConfirm"
                        Content="Xác nhận"
                        Width="120"
                        Height="40"
                        Background="#2F80ED"
                        Foreground="White"
                        BorderThickness="0"
                        Click="btnConfirm_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Bên phải: thông tin ghế/chuyến -->
        <Border Grid.Column="2"
                Background="White"
                CornerRadius="12"
                Padding="20"
                BorderBrush="#D9E2EC"
                BorderThickness="1">

            <StackPanel>
                <TextBlock Text="Thông tin đã chọn"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#102A43"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Flight ID" FontWeight="SemiBold"/>
                <Border Background="#F0F4F8" CornerRadius="8" Padding="12" Margin="0,6,0,14">
                    <TextBlock x:Name="txtFlightId" Text="---"/>
                </Border>

                <TextBlock Text="Ghế đã chọn" FontWeight="SemiBold"/>
                <Border Background="#F0F4F8" CornerRadius="8" Padding="12" Margin="0,6,0,14">
                    <TextBlock x:Name="txtSeatNumber" Text="---"/>
                </Border>

                <TextBlock Text="Hạng ghế" FontWeight="SemiBold"/>
                <Border Background="#F0F4F8" CornerRadius="8" Padding="12" Margin="0,6,0,14">
                    <TextBlock x:Name="txtSeatClassInfo" Text="---"/>
                </Border>

                <TextBlock Text="Giữ chỗ tạm thời" FontWeight="SemiBold"/>
                <Border Background="#F0F4F8" CornerRadius="8" Padding="12" Margin="0,6,0,14">
                    <TextBlock Text="30 phút"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>