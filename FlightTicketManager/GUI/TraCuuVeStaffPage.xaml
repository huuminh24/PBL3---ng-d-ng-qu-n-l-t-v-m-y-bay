<Page x:Class="FlightTicketManager.GUI.TraCuuVeStaffPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tra cứu &amp; quản lý vé"
      Background="#F8FAFD">

    <Page.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeChipStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChipBorder"
                                Background="#F1F5F9"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#E0F2FE"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="220"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="24" ClipToBounds="True">
                <Border.Background>
                    <ImageBrush ImageSource="/GUI/Images/Designer.png"
                                Stretch="UniformToFill"/>
                </Border.Background>

                <Grid>
                    <Rectangle Fill="#45000000"/>

                    <Grid Margin="28,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tìm &amp; đặt vé hộ cho khách nhanh hơn"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Giao diện theo phong cách travel booking: sáng, bo tròn, gọn và dễ thao tác."
                                       Margin="0,10,0,0"
                                       FontSize="14"
                                       Foreground="#E0F2FE"
                                       TextWrapping="Wrap"
                                       Width="560"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#22FFFFFF"
                                CornerRadius="18"
                                Padding="14"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Hỗ trợ nhanh"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="- Tra cứu chuyến bay&#x0a;- Đặt vé hộ&#x0a;- Quản lý vé đã đặt"
                                           Margin="0,8,0,0"
                                           FontSize="12"
                                           Foreground="#F8FAFC"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="28,-36,28,0"
                    Background="White"
                    CornerRadius="22"
                    Padding="18"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RdoMotChieu"
                                         Content="Một chiều"
                                         Style="{StaticResource ModeChipStyle}"
                                         IsChecked="True"/>
                            <RadioButton x:Name="RdoKhuHoi"
                                         Content="Khứ hồi"
                                         Style="{StaticResource ModeChipStyle}"/>
                            <RadioButton x:Name="RdoNhieuThanhPho"
                                         Content="Nhiều thành phố"
                                         Style="{StaticResource ModeChipStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <CheckBox x:Name="ChkBayThang"
                                      Content="Bay thẳng"
                                      Margin="0,0,16,0"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="Nhân viên có thể chọn số lượng hành khách ngay tại đây"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource InfoBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Từ" FontSize="12" Foreground="#94A3B8"/>
                                <ComboBox x:Name="CboNoiDi" Margin="0,6,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="Đà Nẵng"/>
                                    <ComboBoxItem Content="Hà Nội"/>
                                    <ComboBoxItem Content="TP.HCM"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource InfoBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Đến" FontSize="12" Foreground="#94A3B8"/>
                                <ComboBox x:Name="CboNoiDen" Margin="0,6,0,0" SelectedIndex="1">
                                    <ComboBoxItem Content="Đà Nẵng"/>
                                    <ComboBoxItem Content="Hà Nội"/>
                                    <ComboBoxItem Content="TP.HCM"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource InfoBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Ngày khởi hành" FontSize="12" Foreground="#94A3B8"/>
                                <DatePicker x:Name="DpNgayDi" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource InfoBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Khứ hồi / Hạng ghế" FontSize="12" Foreground="#94A3B8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <DatePicker x:Name="DpNgayVe" Width="140" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CboHangGheTimKiem" Width="110" SelectedIndex="0">
                                        <ComboBoxItem Content="Economy"/>
                                        <ComboBoxItem Content="Business"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- KHỐI MỚI: NGƯỜI LỚN / TRẺ EM -->
                        <Border Grid.Column="4" Style="{StaticResource InfoBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Số lượng hành khách" FontSize="12" Foreground="#94A3B8"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Người lớn" FontSize="12" Foreground="#64748B"/>
                                        <ComboBox x:Name="CboNguoiLon" Margin="0,4,0,0" SelectedIndex="0">
                                            <ComboBoxItem Content="1"/>
                                            <ComboBoxItem Content="2"/>
                                            <ComboBoxItem Content="3"/>
                                            <ComboBoxItem Content="4"/>
                                            <ComboBoxItem Content="5"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Trẻ em" FontSize="12" Foreground="#64748B"/>
                                        <ComboBox x:Name="CboTreEm" Margin="0,4,0,0" SelectedIndex="0">
                                            <ComboBoxItem Content="0"/>
                                            <ComboBoxItem Content="1"/>
                                            <ComboBoxItem Content="2"/>
                                            <ComboBoxItem Content="3"/>
                                            <ComboBoxItem Content="4"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="5"
                                Margin="0,14,0,0"
                                Height="56"
                                Content="Tìm chuyến bay"
                                Background="#0EA5E9"
                                Click="BtnTimChuyenBay_Click"
                                Style="{StaticResource RoundedButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2"/>

            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="18"
                    Padding="16"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">
                <TabControl>
                    <TabItem Header="Tra cứu chuyến bay">
                        <StackPanel Margin="10">
                            <TextBlock Text="Danh sách chuyến bay phù hợp"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#1E88E5"
                                       Margin="0,0,0,12"/>

                            <DataGrid x:Name="DgChuyenBay"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      Height="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã chuyến" Binding="{Binding MaChuyenBay}" Width="110"/>
                                    <DataGridTextColumn Header="Nơi đi" Binding="{Binding NoiDi}" Width="*"/>
                                    <DataGridTextColumn Header="Nơi đến" Binding="{Binding NoiDen}" Width="*"/>
                                    <DataGridTextColumn Header="Giờ khởi hành" Binding="{Binding GioKhoiHanh}" Width="150"/>
                                    <DataGridTemplateColumn Header="Thao tác" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Đặt vé hộ"
                                                        Background="#22C55E"
                                                        BorderBrush="Transparent"
                                                        Click="BtnDatVeHo_Click"
                                                        Tag="{Binding}"
                                                        Style="{StaticResource RoundedButtonStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Tra cứu vé đã đặt">
                        <StackPanel Margin="10">
                            <TextBlock Text="Danh sách vé đã đặt"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#1E88E5"
                                       Margin="0,0,0,12"/>

                            <DataGrid x:Name="DgVe"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      Height="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã vé" Binding="{Binding MaVe}" Width="90"/>
                                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding TenKhachHang}" Width="150"/>
                                    <DataGridTextColumn Header="Chuyến bay" Binding="{Binding MaChuyenBay}" Width="100"/>
                                    <DataGridTextColumn Header="Ghế" Binding="{Binding SoGhe}" Width="70"/>
                                    <DataGridTextColumn Header="Hạng ghế" Binding="{Binding HangGhe}" Width="100"/>
                                    <DataGridTextColumn Header="Giá vé" Binding="{Binding GiaVeHienThi}" Width="110"/>
                                    <DataGridTextColumn Header="Thanh toán" Binding="{Binding PhuongThucThanhToan}" Width="110"/>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="110"/>
                                    <DataGridTemplateColumn Header="Thao tác" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Hủy vé hộ"
                                                        Background="#EF4444"
                                                        BorderBrush="Transparent"
                                                        Click="BtnHuyVe_Click"
                                                        Tag="{Binding}"
                                                        Style="{StaticResource RoundedButtonStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
