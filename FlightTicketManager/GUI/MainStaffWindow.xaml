<Window x:Class="FlightTicketManager.GUI.MainStaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Staff Dashboard"
        Height="720"
        Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="16" Padding="18" Margin="0 0 0 12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="PBL3 Airlines - Staff"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>
                    <TextBlock Text="Quản lý vé và hỗ trợ khách tại quầy"
                               Margin="0 4 0 0"
                               FontSize="12"
                               Foreground="#64748B"/>
                </StackPanel>

                <Button x:Name="BtnMenuTraCuuVe"
                        Grid.Column="1"
                        Width="180"
                        Height="40"
                        Margin="12 0 12 0"
                        Content="Tra cứu &amp; quản lý vé"
                        Click="BtnTraCuuVe_Click"
                        Background="#1E88E5"
                        Foreground="White"
                        BorderBrush="Transparent"/>

                <Button x:Name="BtnMenuThongKe"
                        Grid.Column="2"
                        Width="160"
                        Height="40"
                        Margin="0 0 12 0"
                        Content="Thống kê doanh thu"
                        Click="BtnThongKeDoanhThu_Click"
                        Background="#EEF2F7"
                        Foreground="#1E293B"
                        BorderBrush="Transparent"/>

                <Button x:Name="BtnDangXuat"
                        Grid.Column="3"
                        Width="110"
                        Height="40"
                        Content="Đăng xuất"
                        Click="BtnDangXuat_Click"
                        Background="#EF4444"
                        Foreground="White"
                        BorderBrush="Transparent"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="18" Padding="12">
            <Frame x:Name="MainContentFrame"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"/>
        </Border>
    </Grid>
</Window>