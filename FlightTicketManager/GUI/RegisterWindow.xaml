<Window x:Class="FlightTicketManager.GUI.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng ký - HmHtravel" Height="720" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EDF2F7">

    <Window.Resources>
        <!-- Màu chủ đạo -->
        <SolidColorBrush x:Key="PrimaryBlue"    Color="#0194F3"/>
        <SolidColorBrush x:Key="DarkBlue"       Color="#0174C2"/>
        <SolidColorBrush x:Key="LabelColor"     Color="#4A5568"/>
        <SolidColorBrush x:Key="PlaceholderGray" Color="#A0AEC0"/>
        <SolidColorBrush x:Key="BorderNormal"   Color="#CBD5E0"/>
        <SolidColorBrush x:Key="ErrorRed"       Color="#E53E3E"/>
        <SolidColorBrush x:Key="White"          Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextDark"       Color="#1A202C"/>

        <!-- Style cho Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource LabelColor}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!-- Style cho Border bao TextBox -->
        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="{StaticResource White}"/>
        </Style>

        <!-- Style cho TextBox bên trong -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
        </Style>

        <!-- Style cho PasswordBox bên trong -->
        <Style x:Key="InputPass" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
        </Style>

        <!-- Style cho nút chính -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource DarkBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="{StaticResource White}" CornerRadius="20" Margin="35" Padding="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#718096" Opacity="0.12" Direction="270" ShadowDepth="6"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="110"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- PHẦN HEADER MÀU XANH -->
                <Border Grid.Row="0" CornerRadius="20,20,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0194F3" Offset="0"/>
                            <GradientStop Color="#0174C2" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Icon máy bay -->
                        <Border Background="#FFFFFF22" CornerRadius="50" Width="48" Height="48"
                                HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="&#x2708;" FontSize="22" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <TextBlock Text="HmHtravel" FontSize="20" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tạo tài khoản mới" FontSize="12" Foreground="#B3DAFF"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- PHẦN FORM -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="35,30,35,30">

                        <!-- Họ và tên -->
                        <TextBlock Text="Họ và tên" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource InputBorder}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="{StaticResource BorderNormal}"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="&#128100;" FontSize="16" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{StaticResource PlaceholderGray}"/>
                                </Border>
                                <TextBox Grid.Column="1" x:Name="txtFullName"
                                         Style="{StaticResource InputBox}"
                                         Tag="Nguyễn Văn A"/>
                            </Grid>
                        </Border>

                        <!-- Tên đăng nhập -->
                        <TextBlock Text="Tên đăng nhập" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource InputBorder}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="{StaticResource BorderNormal}"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="@" FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource PlaceholderGray}"/>
                                </Border>
                                <TextBox Grid.Column="1" x:Name="txtUsername"
                                         Style="{StaticResource InputBox}"
                                         Tag="ten_dang_nhap"/>
                            </Grid>
                        </Border>

                        <!-- Mật khẩu -->
                        <TextBlock Text="Mật khẩu" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource InputBorder}" Margin="0,0,0,28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="{StaticResource BorderNormal}"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="&#128274;" FontSize="15" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{StaticResource PlaceholderGray}"/>
                                </Border>
                                <PasswordBox Grid.Column="1" x:Name="txtPassword"
                                             Style="{StaticResource InputPass}"/>
                            </Grid>
                        </Border>

                        <!-- Nút đăng ký -->
                        <Button x:Name="btnRegister"
                                Content="Tạo tài khoản"
                                Style="{StaticResource PrimaryButton}"
                                Click="btnRegister_Click"
                                Margin="0,0,0,22"/>

                        <!-- Divider -->
                        <Grid Margin="0,0,0,22">
                            <Rectangle Fill="{StaticResource BorderNormal}" Height="1" VerticalAlignment="Center"/>
                            <Border Background="White" Padding="10,0" HorizontalAlignment="Center">
                                <TextBlock Text="hoặc" Foreground="{StaticResource PlaceholderGray}" FontSize="12"/>
                            </Border>
                        </Grid>

                        <!-- Quay lại đăng nhập -->
                        <Border BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="1"
                                CornerRadius="10" Height="48" Background="Transparent" Cursor="Hand"
                                Margin="0,0,0,20" MouseLeftButtonDown="lblBackToLogin_Click">
                            <TextBlock Text="Quay lại Đăng nhập"
                                       Foreground="{StaticResource PrimaryBlue}"
                                       FontWeight="SemiBold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>