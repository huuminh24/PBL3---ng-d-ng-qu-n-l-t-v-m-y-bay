<Window x:Class="FlightTicketManager.GUI.FlightSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vietjet Air - Bay là thích ngay!" Height="768" Width="1100" WindowStartupLocation="CenterScreen">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF0DF" Offset="0"/>
            <GradientStop Color="#FFD2C0" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Border Width="450" Height="480" Background="#DA2128" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,80,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.3" Direction="315"/>
            </Border.Effect>

            <StackPanel Margin="25">
                <TextBlock Text="Mua hành lý, suất ăn, chọn chỗ ngồi và hơn thế nữa..." 
                           Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <RadioButton Content="Khứ hồi" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,15,0" Cursor="Hand"/>
                    <RadioButton Content="Một chiều" Foreground="White" FontSize="15" FontWeight="SemiBold" IsChecked="True" Margin="0,0,15,0" Cursor="Hand"/>
                    <TextBlock Text="Nhiều chặng ↗" Foreground="White" FontSize="14" TextDecorations="Underline" Cursor="Hand" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <Grid Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="5">
                        <TextBox x:Name="txtOrigin" BorderThickness="0" Background="Transparent" FontSize="16" Padding="15,13" Text="✈  Điểm khởi hành" Foreground="#555"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Background="White" CornerRadius="5">
                        <DatePicker x:Name="dpDeparture" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,10"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Background="White" CornerRadius="5">
                        <TextBox x:Name="txtDestination" BorderThickness="0" Background="Transparent" FontSize="16" Padding="15,13" Text="✈  Điểm đến" Foreground="#555"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" Background="White" CornerRadius="5">
                        <DatePicker x:Name="dpReturn" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,10" IsEnabled="False"/>
                    </Border>
                </Grid>

                <Border Background="White" CornerRadius="5" Height="50" Margin="0,0,0,15">
                    <ComboBox x:Name="cbPassengers" BorderThickness="0" Background="Transparent" FontSize="16" Padding="15,13" SelectedIndex="0">
                        <ComboBoxItem Content="👤  1 người lớn"/>
                        <ComboBoxItem Content="👤  2 người lớn"/>
                        <ComboBoxItem Content="👤  1 người lớn, 1 trẻ em"/>
                    </ComboBox>
                </Border>

                <Border Background="White" CornerRadius="5" Height="50" Margin="0,0,0,15">
                    <TextBox x:Name="txtPromoCode" BorderThickness="0" Background="Transparent" FontSize="16" Padding="15,13" Text="🎟  Mã khuyến mại" Foreground="#555"/>
                </Border>

                <CheckBox Content="Tìm vé rẻ nhất" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,20" Cursor="Hand"/>

                <Button x:Name="btnSearchFlight" Content="Tìm chuyến bay" Background="#F2C00F" Foreground="#DA2128" 
                        FontSize="18" FontWeight="Bold" Height="50" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="25"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <TextBlock Text="[Khu vực này sau này bạn chèn ảnh Banner Vietjet vào nhé]" 
                   FontSize="20" Foreground="#A0000000" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="100,0,0,0" Width="300" TextWrapping="Wrap" TextAlignment="Center"/>
    </Grid>
</Window>