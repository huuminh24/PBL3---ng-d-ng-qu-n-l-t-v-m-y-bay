<Window x:Class="FlightTicketManager.GUI.FlightSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tìm chuyến bay"
        Height="760"
        Width="1150"
        MinHeight="700"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Form tìm kiếm ở giữa -->
            <Border Grid.Row="0"
                    Width="520"
                    HorizontalAlignment="Center"
                    Background="#DA2128"
                    CornerRadius="18"
                    Padding="28">
                <StackPanel>
                    <TextBlock Text="TÌM CHUYẾN BAY"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Chọn điểm đi, điểm đến, ngày bay để tìm chuyến bay phù hợp"
                               Foreground="White"
                               FontSize="14"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,22"/>

                    <!-- Điểm đi -->
                    <TextBlock Text="Điểm đi"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="2,0,0,6"/>
                    <Border Background="White" CornerRadius="8" Height="46" Margin="0,0,0,14">
                        <TextBox x:Name="txtOrigin"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="16"
                                 VerticalContentAlignment="Center"
                                 Padding="14,0"
                                 Text="SGN"/>
                    </Border>

                    <!-- Điểm đến -->
                    <TextBlock Text="Điểm đến"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="2,0,0,6"/>
                    <Border Background="White" CornerRadius="8" Height="46" Margin="0,0,0,14">
                        <TextBox x:Name="txtDestination"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="16"
                                 VerticalContentAlignment="Center"
                                 Padding="14,0"
                                 Text="HAN"/>
                    </Border>

                    <!-- Ngày bay + số hành khách -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ngày bay"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="2,0,0,6"/>
                            <Border Background="White" CornerRadius="8" Height="46">
                                <DatePicker x:Name="dpDeparture"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            FontSize="14"
                                            Padding="8,6"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Số hành khách"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="2,0,0,6"/>
                            <Border Background="White" CornerRadius="8" Height="46">
                                <ComboBox x:Name="cbPassengers"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          FontSize="15"
                                          SelectedIndex="0"
                                          VerticalContentAlignment="Center"
                                          Padding="10,6">
                                    <ComboBoxItem Content="1 người lớn"/>
                                    <ComboBoxItem Content="2 người lớn"/>
                                    <ComboBoxItem Content="1 người lớn, 1 trẻ em"/>
                                </ComboBox>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Ví dụ mã sân bay: SGN, HAN, DAD"
                               Foreground="#FFE9B8"
                               FontSize="12"
                               Margin="2,0,0,16"/>

                    <Button x:Name="btnSearchFlight"
                            Content="Tìm chuyến bay"
                            Height="48"
                            Background="#F2C00F"
                            Foreground="#9B1116"
                            FontSize="18"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="btnSearchFlight_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="24"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Khu kết quả -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="16"
                    Padding="20"
                    BorderBrush="#D9E2EC"
                    BorderThickness="1"
                    MinHeight="360">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Danh sách chuyến bay phù hợp"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#102A43"/>

                    <DataGrid x:Name="dgFlights"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              RowHeight="38"
                              Height="260"
                              GridLinesVisibility="Horizontal"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã chuyến bay" Binding="{Binding FlightCode}" Width="120"/>
                            <DataGridTextColumn Header="Hãng" Binding="{Binding AirlineName}" Width="180"/>
                            <DataGridTextColumn Header="Điểm đi" Binding="{Binding DepartureCode}" Width="90"/>
                            <DataGridTextColumn Header="Điểm đến" Binding="{Binding ArrivalCode}" Width="90"/>
                            <DataGridTextColumn Header="Giờ đi" Binding="{Binding DepartureTime, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/>
                            <DataGridTextColumn Header="Giờ đến" Binding="{Binding ArrivalTime, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/>
                            <DataGridTextColumn Header="Giá Economy" Binding="{Binding EconomyPrice}" Width="130"/>
                            <DataGridTextColumn Header="Ghế trống" Binding="{Binding AvailableSeats}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnSelectFlight"
                                Content="Chọn chuyến bay"
                                Width="155"
                                Height="42"
                                Background="#2F80ED"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Click="btnSelectFlight_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>