<Window x:Class="FlightTicketManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HmHtravel - Trang chủ" Height="720" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#1A4D8F"/>
        <SolidColorBrush x:Key="DarkBlue" Color="#0C3B6E"/>
        <SolidColorBrush x:Key="OrangeAccent" Color="#FF5E1F"/>
        <SolidColorBrush x:Key="LightBlue" Color="#38A0D7"/>
        <SolidColorBrush x:Key="GrayText" Color="#687176"/>
        <SolidColorBrush x:Key="LightGray" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="BorderGray" Color="#DADADA"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource DarkBlue}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" FontSize="22" FontWeight="Bold" 
                       Foreground="{StaticResource LightBlue}" VerticalAlignment="Top" Margin="27,10,13,0"><Run Language="vi-vn" Text="HmHtravel"/></TextBlock>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,40,0">
                <Border BorderBrush="{StaticResource LightBlue}" BorderThickness="1" CornerRadius="4" Padding="12,6" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonDown="btnHeaderLogin_Click">
                    <TextBlock Text="Đăng Nhập" Foreground="{StaticResource LightBlue}" FontSize="13"/>
                </Border>
                <Border Background="{StaticResource OrangeAccent}" CornerRadius="4" Padding="12,6" Cursor="Hand" MouseLeftButtonDown="btnHeaderRegister_Click">
                    <TextBlock Text="Đăng ký" Foreground="White" FontSize="13"/>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Background="{StaticResource PrimaryBlue}">
        </Grid>

        <Grid Grid.Row="2">
            <Grid.Background>
                <ImageBrush ImageSource="/Images/phongcanh.png" Stretch="UniformToFill" TileMode="None" AlignmentY="Top"/>
            </Grid.Background>

            <Border Background="#1A4D8F" Opacity="0.5"/>

            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,50,0,0">

                <TextBlock Text="App du lịch hàng đầu, một chạm đi bất cứ đâu" 
                           Foreground="White" FontSize="30" FontWeight="Light" 
                           HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <Border Background="White" CornerRadius="12" Width="1050" Padding="25">
                    <StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <Border BorderBrush="{StaticResource LightBlue}" BorderThickness="1" CornerRadius="20" Padding="15,8">
                                <TextBlock Text="Vé máy bay" Foreground="{StaticResource LightBlue}" FontSize="14" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <Rectangle Fill="{StaticResource LightGray}" Height="1" Margin="0,10,0,15"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Border Background="{StaticResource LightBlue}" CornerRadius="18" Padding="15,8" Margin="0,0,10,0">
                                <TextBlock Text="Một chiều / Khứ hồi" Foreground="White" FontSize="13"/>
                            </Border>
                            <TextBlock Text="Nhiều thành phố" Foreground="{StaticResource GrayText}" FontSize="13" VerticalAlignment="Center" Margin="15,0,30,0"/>
                            <CheckBox VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Bay thẳng" Foreground="{StaticResource GrayText}" FontSize="13" VerticalAlignment="Center" Margin="0,0,30,0"/>
                            <Border Background="{StaticResource LightBlue}" CornerRadius="4" Padding="12,8" Margin="0,0,10,0">
                                <TextBlock Text="1 Người lớn, 0 Trẻ em, 0 Em bé" Foreground="White" FontSize="13"/>
                            </Border>
                            <Border Background="{StaticResource LightGray}" CornerRadius="4" Padding="12,8" Width="109">
                                <TextBlock Text="Phổ thông" Foreground="{StaticResource GrayText}" FontSize="13"/>
                            </Border>
                        </StackPanel>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Từ" Foreground="{StaticResource GrayText}" FontSize="13"/>
                            <TextBlock Grid.Column="2" Text="Đến" Foreground="{StaticResource GrayText}" FontSize="13"/>
                            <TextBlock Grid.Column="3" Text="Ngày khởi hành" Foreground="{StaticResource GrayText}" FontSize="13"/>
                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <CheckBox IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Khứ hồi" Foreground="{StaticResource GrayText}" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="550"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" CornerRadius="8" Margin="0,0,15,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="15,10">
                                        <TextBlock Text="TP HCM (SGN)" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="Sân bay Tân Sơn Nhất" Foreground="{StaticResource GrayText}" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="{StaticResource LightGray}" CornerRadius="20" Width="36" Height="36" VerticalAlignment="Center">
                                        <TextBlock Text="&lt;-&gt;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource LightBlue}"/>
                                    </Border>

                                    <StackPanel Grid.Column="2" Margin="15,10">
                                        <TextBlock Text="Bangkok (BKKA)" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="Tất cả sân bay" Foreground="{StaticResource GrayText}" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Column="1" Margin="0,0,15,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="{StaticResource BorderGray}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="12,10">
                                    <TextBlock Text="18 thg 4 2026" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Border>

                                <Border Grid.Column="1" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" CornerRadius="0,8,8,0" Padding="12,10">
                                    <TextBlock Text="20 thg 4 2026" FontSize="14" Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <Border Grid.Column="2" Background="{StaticResource OrangeAccent}" CornerRadius="8" Width="56" Height="56">
                                <TextBlock Text="Q" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <TextBlock Text="Tìm kiếm" Foreground="{StaticResource LightBlue}" FontWeight="SemiBold" FontSize="14" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>